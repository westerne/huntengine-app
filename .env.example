# Copy to .env.local and fill in. Never commit real values.

# Analysis engine (required)
OPENAI_API_KEY=

# Beta gate — testers' shared code (until accounts launch)
BETA_ACCESS_CODE=

# Accounts + database (Supabase) — accounts stay off until both URL and anon key are set
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Annual membership (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=

# Optional: GA4 override (production uses the HuntQuarters property by default)
NEXT_PUBLIC_GA_ID=
